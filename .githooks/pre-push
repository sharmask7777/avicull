#!/usr/bin/env bash
set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$REPO_ROOT"

BOLD='\033[1m'
GREEN='\033[0;32m'
RED='\033[0;31m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "\n${BOLD}${BLUE}==============================================${NC}"
echo -e "${BOLD}${BLUE}  avicull Pre-Push Verification Suite         ${NC}"
echo -e "${BOLD}${BLUE}==============================================${NC}\n"

# Preflight Tooling Checks
command -v cargo >/dev/null 2>&1 || {
    echo -e "${RED}✗ 'cargo' is not installed or not in PATH.${NC}\n"
    exit 1
}
command -v uv >/dev/null 2>&1 || {
    echo -e "${RED}✗ 'uv' is not installed. Install via: brew install uv${NC}\n"
    exit 1
}

# 1. Rust Code Formatting
echo -e "${BOLD}[1/7] Checking Rust code formatting (cargo fmt)...${NC}"
if cargo fmt --check; then
    echo -e "${GREEN}✓ cargo fmt passed.${NC}\n"
else
    echo -e "${RED}✗ cargo fmt failed. Run 'cargo fmt' to fix.${NC}\n"
    exit 1
fi

# 2. Rust Linter (Clippy)
echo -e "${BOLD}[2/7] Running Rust linter (cargo clippy -- -D warnings)...${NC}"
if cargo clippy -- -D warnings; then
    echo -e "${GREEN}✓ cargo clippy passed.${NC}\n"
else
    echo -e "${RED}✗ cargo clippy reported warnings or errors.${NC}\n"
    exit 1
fi

# 3. Rust Unit, Integration & Spec Conformance Tests
echo -e "${BOLD}[3/7] Running Rust unit, integration & spec conformance tests...${NC}"
if cargo test --test test_suite --test test_mock_directory_structure_e2e -- --skip test_e2e_real_samples; then
    echo -e "${GREEN}✓ cargo test passed (all unit & integration tests green).${NC}\n"
else
    echo -e "${RED}✗ cargo test failed.${NC}\n"
    exit 1
fi

# 4. Python Unit & Inference Tests
echo -e "${BOLD}[4/7] Running Python unit & inference tests (tests_python)...${NC}"
if uv run --with "torch,open-clip-torch,safetensors,ultralytics,pillow" python3 -m unittest discover -s tests_python; then
    echo -e "${GREEN}✓ Python test suite passed.${NC}\n"
else
    echo -e "${RED}✗ Python tests failed.${NC}\n"
    exit 1
fi

# 5. Real Samples & Mock Directory Structure E2E Tests on Locally Compiled Build
echo -e "${BOLD}[5/7] Running Real Samples & Mock Directory Structure E2E Tests on Locally Compiled Build...${NC}"
LOCAL_BIN="$REPO_ROOT/target/debug/avicull"
if cargo build --bin avicull; then
    if AVICULL_BIN="$LOCAL_BIN" cargo test --test test_e2e_real_samples -- --nocapture && \
       AVICULL_BIN="$LOCAL_BIN" cargo test --test test_mock_directory_structure_e2e -- --nocapture; then
        echo -e "${GREEN}✓ Real samples & mock directory structure E2E test passed on locally compiled binary ($LOCAL_BIN).${NC}\n"
    else
        echo -e "${RED}✗ Real samples or mock directory structure E2E test failed on locally compiled binary.${NC}\n"
        exit 1
    fi
else
    echo -e "${RED}✗ Local binary build failed.${NC}\n"
    exit 1
fi

# 6. Real Samples & Mock Directory Structure E2E Tests on Latest Generated Release Binary (if present)
echo -e "${BOLD}[6/7] Checking for generated release binary to test...${NC}"
RELEASE_BIN=""
if [ -f "dist/avicull" ]; then
    RELEASE_BIN="dist/avicull"
elif [ -d "dist" ]; then
    FOUND=$(find dist -maxdepth 2 -type f -name "avicull" -perm -111 2>/dev/null | head -n 1)
    if [ -n "$FOUND" ]; then
        RELEASE_BIN="$FOUND"
    fi
fi
if [ -z "$RELEASE_BIN" ] && [ -f "target/release/avicull" ]; then
    RELEASE_BIN="target/release/avicull"
fi

if [ -n "$RELEASE_BIN" ] && [ -x "$RELEASE_BIN" ]; then
    case "$RELEASE_BIN" in
        /*) FULL_RELEASE_BIN="$RELEASE_BIN" ;;
        *)  FULL_RELEASE_BIN="$REPO_ROOT/$RELEASE_BIN" ;;
    esac
    echo -e "Found release binary: ${BOLD}$FULL_RELEASE_BIN${NC}. Running E2E verification..."
    if AVICULL_BIN="$FULL_RELEASE_BIN" cargo test --test test_e2e_real_samples -- --nocapture && \
       AVICULL_BIN="$FULL_RELEASE_BIN" cargo test --test test_mock_directory_structure_e2e -- --nocapture; then
        echo -e "${GREEN}✓ Real samples & mock directory structure E2E test passed on release binary ($FULL_RELEASE_BIN).${NC}\n"
    else
        echo -e "${RED}✗ Real samples or mock directory structure E2E test failed on release binary ($FULL_RELEASE_BIN).${NC}\n"
        exit 1
    fi
else
    echo -e "No release binary currently generated in dist/ or target/release/ (skipping release verification).\n"
fi

# 7. Gazetteer & Regional Checklist Integrity Check
echo -e "${BOLD}[7/8] Running Gazetteer & Regional Checklist integrity check (pytest)...${NC}"
if command -v pytest >/dev/null 2>&1; then
    PYTEST_CMD="pytest"
else
    PYTEST_CMD="uv run --with pytest pytest"
fi

if $PYTEST_CMD tests/test_build_gazetteer.py; then
    echo -e "${GREEN}✓ Gazetteer & regional checklist integrity test passed.${NC}\n"
else
    echo -e "${RED}✗ Gazetteer & regional checklist integrity test failed.${NC}\n"
    exit 1
fi

# 8. Build-Time Blocking Code Coverage Metric Gate
echo -e "${BOLD}[8/8] Checking build-time code coverage metrics (cargo-llvm-cov)...${NC}"
if command -v cargo-llvm-cov >/dev/null 2>&1; then
    # Blocking coverage gate requiring at least 80% line coverage across the codebase (aspiring to 95-100%)
    if cargo llvm-cov --fail-under-lines 80 --lib --test test_suite --test test_mock_directory_structure_e2e -- --skip test_e2e_real_samples; then
        echo -e "${GREEN}✓ Code coverage metrics passed blocking gate (>80%).${NC}\n"
    else
        echo -e "${RED}✗ Code coverage metric fell below minimum required threshold (80%).${NC}\n"
        exit 1
    fi
else
    echo -e "${RED}✗ cargo-llvm-cov is not installed. Install via: brew install cargo-llvm-cov${NC}\n"
    exit 1
fi

echo -e "${BOLD}${GREEN}==============================================${NC}"
echo -e "${BOLD}${GREEN}  All Pre-Push Verifications Succeeded!       ${NC}"
echo -e "${BOLD}${GREEN}==============================================${NC}\n"
exit 0
