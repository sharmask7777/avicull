y","rocky mountain goat":"Mammalia","rocky_mountain_goat":"Mammalia","roe deer":"Mammalia","roe_deer":"Mammalia","royal bengal tiger":"Mammalia","royal_bengal_tiger":"Mammalia","royle's pika":"Mammalia","royle's_pika":"Mammalia","sahara oryx":"Mammalia","sahara_oryx":"Mammalia","saiga":"Mammalia","saiga antelope":"Mammalia","saiga_antelope":"Mammalia","sambar":"Mammalia","sambar deer":"Mammalia","sambar_deer":"Mammalia","sand dunes":"Scenery","sand_dunes":"Scenery","savanna elephant":"Mammalia","savanna_elephant":"Mammalia","scaly anteater":"Mammalia","scaly_anteater":"Mammalia","scen_aurora":"Scenery","scen_coastline":"Scenery","scen_desert":"Scenery","scen_forest":"Scenery","scen_mountain":"Scenery","scen_night_sky":"Scenery","scen_rainbow":"Scenery","scen_sunset":"Scenery","scen_valley":"Scenery","scen_waterfall":"Scenery","scimitar-horned oryx":"Mammalia","scimitar-horned_oryx":"Mammalia","scimitar_horned oryx":"Mammalia","scimitar_horned_oryx":"Mammalia","sea leopard":"Mammalia","sea lion":"Mammalia","sea otter":"Mammalia","sea_leopard":"Mammalia","sea_lion":"Mammalia","sea_otter":"Mammalia","seashore":"Scenery","serval":"Mammalia","short-beaked echidna":"Mammalia","short-beaked_echidna":"Mammalia","short_beaked echidna":"Mammalia","short_beaked_echidna":"Mammalia","siberian ibex":"Mammalia","siberian_ibex":"Mammalia","silver-backed jackal":"Mammalia","silver-backed_jackal":"Mammalia","silver_backed jackal":"Mammalia","silver_backed_jackal":"Mammalia","simba":"Mammalia","skyscraper":"Architecture","sloth bear":"Mammalia","sloth_bear":"Mammalia","snow leopard":"Mammalia","snow monkey":"Mammalia","snow_leopard":"Mammalia","snow_monkey":"Mammalia","snowshoe hare":"Mammalia","snowshoe_hare":"Mammalia","south african oryx":"Mammalia","south_african_oryx":"Mammalia","southern elephant seal":"Mammalia","southern giraffe":"Mammalia","southern_elephant_seal":"Mammalia","southern_giraffe":"Mammalia","spectacled bear":"Mammalia","spectacled_bear":"Mammalia","sperm whale":"Mammalia","sperm_whale":"Mammalia","spinner dolphin":"Mammalia","spinner_dolphin":"Mammalia","spiny anteater":"Mammalia","spiny_anteater":"Mammalia","spotted deer":"Mammalia","spotted hyena":"Mammalia","spotted_deer":"Mammalia","spotted_hyena":"Mammalia","springbok":"Mammalia","square-lipped rhinoceros":"Mammalia","square-lipped_rhinoceros":"Mammalia","square_lipped rhinoceros":"Mammalia","square_lipped_rhinoceros":"Mammalia","starry night sky":"Scenery","starry_night_sky":"Scenery","steinbock":"Mammalia","street portrait":"Portrait","street_portrait":"Portrait","striped hyena":"Mammalia","striped_hyena":"Mammalia","sugar glider":"Mammalia","sugar_glider":"Mammalia","sulphur-bottom whale":"Mammalia","sulphur-bottom_whale":"Mammalia","sulphur_bottom whale":"Mammalia","sulphur_bottom_whale":"Mammalia","sumatran orangutan":"Mammalia","sumatran_orangutan":"Mammalia","sun bear":"Mammalia","sun_bear":"Mammalia","sunrise":"Scenery","sunset sky":"Scenery","sunset_sky":"Scenery","suricate":"Mammalia","susu":"Mammalia","swamp deer":"Mammalia","swamp_deer":"Mammalia","tasmanian devil":"Mammalia","tasmanian_devil":"Mammalia","thinhorn sheep":"Mammalia","thinhorn_sheep":"Mammalia","three-toed sloth":"Mammalia","three-toed_sloth":"Mammalia","three_toed sloth":"Mammalia","three_toed_sloth":"Mammalia","tibetan antelope":"Mammalia","tibetan gazelle":"Mammalia","tibetan hare":"Mammalia","tibetan wild ass":"Mammalia","tibetan_antelope":"Mammalia","tibetan_gazelle":"Mammalia","tibetan_hare":"Mammalia","tibetan_wild_ass":"Mammalia","tierboskat":"Mammalia","tiger":"Mammalia","timber wolf":"Mammalia","timber_wolf":"Mammalia","tower":"Architecture","two-humped camel":"Mammalia","two-humped_camel":"Mammalia","two_humped camel":"Mammalia","two_humped_camel":"Mammalia","vampire bat":"Mammalia","vampire_bat":"Mammalia","varying hare":"Mammalia","varying_hare":"Mammalia","vicuña":"Mammalia","virginia deer":"Mammalia","virginia opossum":"Mammalia","virginia_deer":"Mammalia","virginia_opossum":"Mammalia","walrus":"Mammalia","wandering glider":"Insecta","wandering_glider":"Insecta","wanderoo":"Mammalia","wapiti":"Mammalia","warthog":"Mammalia","water ripples and refraction texture":"Abstract","water texture":"Abstract","water_ripples_and_refraction_texture":"Abstract","water_texture":"Abstract","waterfall":"Scenery","western gorilla":"Mammalia","western hoolock gibbon":"Mammalia","western lowland gorilla":"Mammalia","western_gorilla":"Mammalia","western_hoolock_gibbon":"Mammalia","western_lowland_gorilla":"Mammalia","white bear":"Mammalia","white fox":"Mammalia","white rhinoceros":"Mammalia","white-handed gibbon":"Mammalia","white-handed_gibbon":"Mammalia","white-headed capuchin":"Mammalia","white-headed_capuchin":"Mammalia","white-nosed coati":"Mammalia","white-nosed_coati":"Mammalia","white-tailed deer":"Mammalia","white-tailed gnu":"Mammalia","white-tailed_deer":"Mammalia","white-tailed_gnu":"Mammalia","white_bear":"Mammalia","white_fox":"Mammalia","white_handed gibbon":"Mammalia","white_handed_gibbon":"Mammalia","white_headed capuchin":"Mammalia","white_headed_capuchin":"Mammalia","white_nosed coati":"Mammalia","white_nosed_coati":"Mammalia","white_rhinoceros":"Mammalia","white_tailed deer":"Mammalia","white_tailed gnu":"Mammalia","white_tailed_deer":"Mammalia","white_tailed_gnu":"Mammalia","wild bactrian camel":"Mammalia","wild boar":"Mammalia","wild pig":"Mammalia","wild water buffalo":"Mammalia","wild yak":"Mammalia","wild_bactrian_camel":"Mammalia","wild_boar":"Mammalia","wild_pig":"Mammalia","wild_water_buffalo":"Mammalia","wild_yak":"Mammalia","wisent":"Mammalia","wolf":"Mammalia","wolverine":"Mammalia","wombat":"Mammalia","woodchuck":"Mammalia","woodland":"Scenery","woolly hare":"Mammalia","woolly_hare":"Mammalia","yak":"Mammalia"};
    if (exactMultiTaxa[s]) return exactMultiTaxa[s];
    const withSpaces = s.replace(/_/g, ' ');
    if (exactMultiTaxa[withSpaces]) return exactMultiTaxa[withSpaces];
    const withUnderscores = s.replace(/ /g, '_');
    if (exactMultiTaxa[withUnderscores]) return exactMultiTaxa[withUnderscores];

    // If fallbackCategory is already a specific non-avian category, respect it
    if (fallbackCategory && fallbackCategory !== AssetCategory.NO_SUBJECT_DETECTED && fallbackCategory !== AssetCategory.BIRD) {
      return fallbackCategory;
    }

    // Check if species is in the curated autocomplete taxonomy of birds (excluding sentinels)
    const isKnownBird = Array.isArray(CATALOG_DATA.species_list) && CATALOG_DATA.species_list.some(b => {
      const lowerB = b.toLowerCase();
      if (lowerB.includes('no bird detected') || lowerB.includes('no_bird_detected') || lowerB.includes('no subject detected') || lowerB.includes('no_subject_detected')) return false;
      return lowerB === s || lowerB === withSpaces || lowerB.replace(/ /g, '_') === s;
    });

    if (isKnownBird) {
      return AssetCategory.BIRD;
    }

    // Unrecognized or unclassified entity: Invariant: NEVER assume unknown entities are birds!
    return AssetCategory.NO_SUBJECT_DETECTED;
  }

  function buildMoveCommandsForItem(item, species) {
    if (!item) return [];
    const isHierarchy = CATALOG_DATA.mode === 'hierarchy';
    const isNoBird = species === 'No Bird Detected' || species === '_No_Bird_Detected' || species.toLowerCase() === 'no bird detected' || species.toLowerCase() === 'no_bird_detected';
    const newSlug = isNoBird ? '_No_Bird_Detected' : sanitizeSlug(species);
    const modeFlag = isHierarchy ? '--mode hierarchy' : (CATALOG_DATA.mode === 'in-place-rename' ? '--mode in-place-rename' : '--mode in-place');

    let commands = [];
    if (CATALOG_DATA.catalog_dir) {
      commands.push(`cd "${CATALOG_DATA.catalog_dir}"`);
    }

    const targetItem = item || activeModalItem;
    const stem = (targetItem && targetItem.original_stem) || (activeModalItem && activeModalItem.original_stem) || '';
    const itemCat = (targetItem && targetItem.category) || (activeModalItem && activeModalItem.category) || AssetCategory.NO_SUBJECT_DETECTED;
    const cat = resolveTargetCategory(species, itemCat);
    commands.push(findAvicullCmd().trim());
    commands.push(`if [ -n "$AVICULL_CMD" ]; then`);
    commands.push(`  avicull correct --category "${cat}" --species "${newSlug}" --file "${activeModalItem ? activeModalItem.original_stem : stem}" 2>/dev/null || $AVICULL_CMD correct --category "${cat}" --species "${newSlug}" --file "${stem}"`);
    commands.push(`else`);

    const currentPath = item.current_path;
    const lastSlash = currentPath.lastIndexOf('/');
    const dir = lastSlash >= 0 ? currentPath.substring(0, lastSlash) : '';
    const allSidecars = [...(item.sidecar_files || []), ...(item.companion_files || [])];

    const isLocal = item.is_local !== false;

    if (isHierarchy) {
      const targetDir = isNoBird ? `birds_hierarchy/_No_Bird_Detected` : `birds_hierarchy/${cat}/${newSlug}`;
      commands.push(`  mkdir -p "${targetDir}"`);
      const filename = lastSlash >= 0 ? currentPath.substring(lastSlash + 1) : currentPath;
      const newPath = `${targetDir}/${filename}`;
      commands.push(`  mv "${currentPath}" "${newPath}"`);

      for (const sc of allSidecars) {
        const scSlash = sc.lastIndexOf('/');
        const scFilename = scSlash >= 0 ? sc.substring(scSlash + 1) : sc;
        commands.push(`mv "${sc}" "${targetDir}/${scFilename}"`);
      }
      if (!isLocal) {
        commands.push(`  if command -v fileproviderctl >/dev/null 2>&1; then`);
        commands.push(`    fileproviderctl evict "${newPath}" >/dev/null 2>&1 || true`);
        commands.push(`  fi`);
      }
    } else if (CATALOG_DATA.mode === 'in-place-rename') {
      // In-place rename format: <stem>_<Species>[_<Date>][_<Location>].<ext>
      const originalStem = item.original_stem;
      const datePart = item.capture_date ? item.capture_date.replace(/[-:/]/g, '') : '';
      const locPart = item.location_name ? sanitizeSlug(item.location_name) : '';

      let tags = [];
      if (newSlug) tags.push(newSlug);
      if (datePart && datePart.toLowerCase() !== 'unknown') tags.push(datePart);
      if (locPart && locPart.toLowerCase() !== 'unknown') tags.push(locPart);

      // Avoid double underscore if newSlug starts with '_' (e.g. _No_Bird_Detected)
      let targetStem = originalStem;
      if (tags.length > 0) {
        if (tags[0].startsWith('_')) {
          const first = tags[0];
          const rest = tags.slice(1);
          targetStem = rest.length > 0 ? `${originalStem}${first}_${rest.join('_')}` : `${originalStem}${first}`;
        } else {
          targetStem = `${originalStem}_${tags.join('_')}`;
        }
      }

      // Primary file extension
      const primaryExt = getExtension(item.primary_filename);
      const searchDir = dir || '.';
      const newPrimary = (dir ? dir + '/' : '') + targetStem + primaryExt;
      commands.push(`  PRIMARY_SRC="${currentPath}"`);
      commands.push(`  if [ ! -f "$PRIMARY_SRC" ]; then`);
      commands.push(`    PRIMARY_CANDIDATE=$(find "${searchDir}" -maxdepth 1 -name "${originalStem}*${primaryExt}" 2>/dev/null | head -n 1)`);
      commands.push(`    if [ -n "$PRIMARY_CANDIDATE" ] && [ -f "$PRIMARY_CANDIDATE" ]; then`);
      commands.push(`      PRIMARY_SRC="$PRIMARY_CANDIDATE"`);
      commands.push(`    fi`);
      commands.push(`  fi`);
      commands.push(`  if [ -f "$PRIMARY_SRC" ] && [ "$PRIMARY_SRC" != "${newPrimary}" ]; then`);
      commands.push(`    mv "$PRIMARY_SRC" "${newPrimary}"`);
      commands.push(`  fi`);

      // Companion and sidecar files
      for (const sc of allSidecars) {
        const scSlash = sc.lastIndexOf('/');
        const scDir = scSlash >= 0 ? sc.substring(0, scSlash) : dir;
        const scFilename = scSlash >= 0 ? sc.substring(scSlash + 1) : sc;
        const scExt = getCompoundExtension(scFilename);
        const newSc = (scDir ? scDir + '/' : '') + targetStem + scExt;
        const scSearchDir = scDir || '.';
        commands.push(`  SC_SRC="${sc}"`);
        commands.push(`  if [ ! -f "$SC_SRC" ]; then`);
        commands.push(`    SC_CANDIDATE=$(find "${scSearchDir}" -maxdepth 1 -name "${originalStem}*${scExt}" 2>/dev/null | head -n 1)`);
        commands.push(`    if [ -n "$SC_CANDIDATE" ] && [ -f "$SC_CANDIDATE" ]; then`);
        commands.push(`      SC_SRC="$SC_CANDIDATE"`);
        commands.push(`    fi`);
        commands.push(`  fi`);
        commands.push(`  if [ -f "$SC_SRC" ] && [ "$SC_SRC" != "${newSc}" ]; then`);
        commands.push(`    mv "$SC_SRC" "${newSc}"`);
        commands.push(`  fi`);
      }
      if (!isLocal) {
        commands.push(`  if command -v fileproviderctl >/dev/null 2>&1; then`);
        commands.push(`    fileproviderctl evict "${newPrimary}" >/dev/null 2>&1 || true`);
        commands.push(`  fi`);
      }
    } else {
      commands.push(`  echo "[WARN] avicull executable not found. In default in-place mode, files on disk are strictly read-only; run avicull directly to record corrections in manifest.sqlite."`);
    }
    commands.push(`  if [ -n "$AVICULL_CMD" ]; then`);
    commands.push(`    $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
    commands.push(`  fi`);
    commands.push(`fi`);

    return commands;
  }

  function buildMoveCommands(species) {
    const targets = activeModalItems.length > 0 ? activeModalItems : (activeModalItem ? [activeModalItem] : []);
    if (targets.length === 0) return [];
    if (targets.length === 1) {
      return buildMoveCommandsForItem(targets[0], species);
    }
    // Concatenate commands for all targets
    let allCommands = [];
    for (const it of targets) {
      allCommands.push(...buildMoveCommandsForItem(it, species));
    }
    return allCommands;
  }

  function markNoBirdDetected() {
    selectSpecies("No Bird Detected");
  }

  function selectSpecies(species) {
    const input = document.getElementById('speciesSearchInput');
    if (input) input.value = species;
    const suggestions = document.getElementById('speciesSuggestions');
    if (suggestions) suggestions.classList.remove('open');

    const targets = activeModalItems.length > 0 ? activeModalItems : (activeModalItem ? [activeModalItem] : []);
    if (targets.length === 0) return;

    for (const it of targets) {
      it._pendingCommands = buildMoveCommandsForItem(it, species);
    }

    const commands = buildMoveCommands(species);
    const cmdStr = commands.join('\n');
    const cmdOutput = document.getElementById('commandOutput');
    if (cmdOutput) cmdOutput.textContent = cmdStr;
    if (activeModalItem) activeModalItem._pendingCommands = commands;
  }

  function getExtension(filename) {
    const idx = filename.indexOf('.');
    return idx >= 0 ? filename.substring(idx) : '';
  }

  function getCompoundExtension(filename) {
    const m = filename.match(/(\.[a-zA-Z0-9]+(?:\.xmp)?)$/i);
    return m ? m[1] : '';
  }

  function copyCurrentCommand() {
    const text = document.getElementById('commandOutput').textContent;
    if (!text || text.startsWith("Select a species")) return;

    // Filter comment lines before copying to clipboard to prevent 'zsh: command not found: #'
    const cleanText = text
      .split('\n')
      .filter(line => !line.trim().startsWith('#'))
      .join('\n');

    navigator.clipboard.writeText(cleanText).then(() => {
      const btn = document.getElementById('btnCopyCommand');
      const orig = btn.textContent;
      btn.textContent = "Copied!";
      setTimeout(() => { btn.textContent = orig; }, 1500);
    }).catch(() => {
      alert("Command: \n\n" + cleanText);
    });
  }

  function addActiveModalToBatch() {
    const targets = activeModalItems.length > 0 ? activeModalItems : (activeModalItem ? [activeModalItem] : []);
    if (targets.length === 0) return;

    for (const it of targets) {
      const cmds = it._pendingCommands || buildMoveCommandsForItem(it, document.getElementById('speciesSearchInput')?.value || '');
      if (cmds && cmds.length > 0) {
        const existingIdx = batchCommands.findIndex(b => (typeof b === 'object' && b && b.stem === it.original_stem));
        if (existingIdx >= 0) {
          batchCommands[existingIdx] = {
            stem: it.original_stem,
            commands: [...cmds]
          };
        } else {
          batchCommands.push({
            stem: it.original_stem,
            commands: [...cmds]
          });
        }
      }
    }

    updateBatchUI();
    closeModal();
  }

  function addToBatch() {
    addActiveModalToBatch();
  }

  function generateBatchScriptContent(forDownload) {
    const isHierarchy = CATALOG_DATA.mode === 'hierarchy';
    const modeFlag = isHierarchy ? '--mode hierarchy' : (CATALOG_DATA.mode === 'in-place-rename' ? '--mode in-place-rename' : '--mode in-place');

    const normalizeBatch = (entries) => {
      let items = [];
      let currentLines = [];
      let currentStem = "";
      let ifDepth = 0;

      for (const entry of entries) {
        if (typeof entry === 'object' && entry && entry.commands) {
          if (currentLines.length > 0) {
            items.push({ stem: currentStem || 'item', commands: currentLines });
            currentLines = [];
            currentStem = '';
            ifDepth = 0;
          }
          items.push(entry);
          continue;
        }

        const str = String(entry);
        const m = str.match(/--file\s+"([^"]+)"/) || str.match(/mv\s+"[^"]*?([^\/"]+)\.[a-zA-Z0-9]+"/);
        if (m && !currentStem) currentStem = m[1];

        const lines = str.split('\n');
        for (const l of lines) {
          const trimmed = l.trim();
          if (/^if\b/.test(trimmed)) ifDepth++;
          if (/^fi\b/.test(trimmed)) ifDepth--;
        }

        currentLines.push(str);

        if (ifDepth <= 0 && currentStem && currentLines.length > 0) {
          items.push({ stem: currentStem, commands: currentLines });
          currentLines = [];
          currentStem = '';
          ifDepth = 0;
        }
      }

      if (currentLines.length > 0) {
        items.push({ stem: currentStem || 'item', commands: currentLines });
      }

      return items;
    };

    const normalizedItems = normalizeBatch(batchCommands);

    const renderItemBlock = (entry, indent) => {
      const stem = entry.stem || 'item';
      const cmds = entry.commands || [];

      let cleanCmds = cmds
        .flatMap(cmd => cmd.split('\n'))
        .filter(line => !line.trim().startsWith('#'))
        .map(cmd => `${indent}    ${cmd}`);

      return [
        `${indent}  if run_correction "${stem}" <<'AVICULL_ITEM_EOF'`,
        ...cleanCmds,
        `AVICULL_ITEM_EOF`,
        `${indent}  then`,
        `${indent}    SUCCESS_COUNT=$((SUCCESS_COUNT + 1))`,
        `${indent}  else`,
        `${indent}    echo "[WARN] Correction failed or file missing for: ${stem} (skipping)"`,
        `${indent}    FAILED_COUNT=$((FAILED_COUNT + 1))`,
        `${indent}  fi`
      ];
    };

    if (forDownload) {
      let bodyLines = [];
      bodyLines.push("#!/usr/bin/env bash");
      bodyLines.push("# Avicull Mislabel Corrections Batch Script");
      bodyLines.push("# Generated automatically by avicull standalone catalog");
      bodyLines.push("set -u");
      bodyLines.push("");
      bodyLines.push(`cd "${CATALOG_DATA.catalog_dir || '.'}"`);
      bodyLines.push("");
      bodyLines.push(findAvicullCmd().trim());
      bodyLines.push("export AVICULL_CMD");
      bodyLines.push("");
      bodyLines.push("SUCCESS_COUNT=0");
      bodyLines.push("FAILED_COUNT=0");
      bodyLines.push("");
      bodyLines.push("run_correction() {");
      bodyLines.push("  local item_label=\"$1\"");
      bodyLines.push("  bash -e");
      bodyLines.push("}");
      bodyLines.push("");

      for (const item of normalizedItems) {
        bodyLines.push(...renderItemBlock(item, ""));
        bodyLines.push("");
      }

      bodyLines.push("if [ -n \"$AVICULL_CMD\" ]; then");
      bodyLines.push("  echo 'Regenerating catalog with updated SQLite overrides...'");
      bodyLines.push(`  $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
      bodyLines.push("fi");
      bodyLines.push("");
      bodyLines.push("echo \"\"");
      bodyLines.push("if [ \"$FAILED_COUNT\" -gt 0 ]; then");
      bodyLines.push("  echo \"⚠️ Completed with $SUCCESS_COUNT succeeded, $FAILED_COUNT failed/skipped.\"");
      bodyLines.push("  exit 1");
      bodyLines.push("else");
      bodyLines.push("  echo '✓ All avicull mislabel corrections applied successfully!'");
      bodyLines.push("fi");
      bodyLines.push("");

      return bodyLines.join('\n');
    }

    let bodyLines = [];
    bodyLines.push("(");
    bodyLines.push(`  cd "${CATALOG_DATA.catalog_dir || '.'}"`);
    bodyLines.push("");

    const cleanFindCmds = findAvicullCmd()
      .trim()
      .split('\n')
      .filter(line => !line.trim().startsWith('#'))
      .map(line => "  " + line);

    bodyLines.push(...cleanFindCmds);
    bodyLines.push("  export AVICULL_CMD");
    bodyLines.push("  SUCCESS_COUNT=0");
    bodyLines.push("  FAILED_COUNT=0");
    bodyLines.push("");
    bodyLines.push("  run_correction() {");
    bodyLines.push("    local item_label=\"$1\"");
    bodyLines.push("    bash -e");
    bodyLines.push("  }");
    bodyLines.push("");

    for (const item of normalizedItems) {
      bodyLines.push(...renderItemBlock(item, ""));
      bodyLines.push("");
    }

    bodyLines.push("  if [ -n \"$AVICULL_CMD\" ]; then");
    bodyLines.push("    echo 'Regenerating catalog with updated SQLite overrides...'");
    bodyLines.push(`    $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
    bodyLines.push("  fi");
    bodyLines.push("  echo \"\"");
    bodyLines.push("  if [ \"$FAILED_COUNT\" -gt 0 ]; then");
    bodyLines.push("    echo \"⚠️ Completed with $SUCCESS_COUNT succeeded, $FAILED_COUNT failed/skipped.\"");
    bodyLines.push("    return 1 2>/dev/null || exit 1");
    bodyLines.push("  else");
    bodyLines.push("    echo '✓ All avicull mislabel corrections applied successfully!'");
    bodyLines.push("  fi");
    bodyLines.push(")");
    bodyLines.push("");

    return bodyLines.join('\n');
  }

  function copyBatchScript() {
    if (batchCommands.length === 0) {
      alert("No mislabel corrections have been added to the batch yet. Click 'Correct Species' on any photo and select 'Add to Batch Script'.");
      return;
    }

    const scriptContent = generateBatchScriptContent(false);
    navigator.clipboard.writeText(scriptContent).then(() => {
      const btn = document.getElementById('btnCopyBatchScript');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 1500);
      }
    }).catch(() => {
      alert("Batch Script: \n\n" + scriptContent);
    });
  }

  function downloadBatchScript() {
    if (batchCommands.length === 0) {
      alert("No mislabel corrections have been added to the batch yet. Click 'Correct Species' on any photo and select 'Add to Batch Script'.");
      return;
    }

    const scriptContent = generateBatchScriptContent(true);

    const blob = new Blob([scriptContent], { type: 'text/x-sh' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = 'apply_corrections.sh';
    document.body.appendChild(a);
    a.click();
    document.body.removeChild(a);
    URL.revokeObjectURL(url);
  }

  function getAllSubdirectories() {
    let dirSet = new Set();
    if (Array.isArray(CATALOG_DATA.directories)) {
      CATALOG_DATA.directories.forEach(d => dirSet.add(d));
    }
    items.forEach(item => {
      if (item.subdirectory) {
        let parts = item.subdirectory.split('/');
        let accum = '';
        parts.forEach(p => {
          accum = accum ? accum + '/' + p : p;
          dirSet.add(accum);
        });
      }
    });
    return Array.from(dirSet).sort();
  }

  function populateSubdirectories() {
    const select = document.getElementById('locationSubdirSelect');
    if (!select) return;

    // Preserve existing selection if possible
    const currentVal = select.value;
    select.innerHTML = '<option value="">-- Choose Subdirectory --</option>';

    const sortedDirs = getAllSubdirectories();
    sortedDirs.forEach(dir => {
      const opt = document.createElement('option');
      opt.value = dir;
      // Indent based on nesting level for visual hierarchy
      const depth = (dir.match(/\//g) || []).length;
      const indent = '\u00A0\u00A0\u00A0\u00A0'.repeat(depth);
      const prefix = depth > 0 ? '\u2514\u2500 ' : '\uD83D\uDCC1 ';
      opt.textContent = indent + prefix + dir;
      select.appendChild(opt);
    });

    if (currentVal && sortedDirs.includes(currentVal)) {
      select.value = currentVal;
    }
  }

  function handleLocationScopeChange() {
    const scopeSelect = document.getElementById('locationScopeSelect');
    const subdirRow = document.getElementById('locationSubdirRow');
    if (!scopeSelect || !subdirRow) return;

    if (scopeSelect.value === 'directory') {
      subdirRow.style.display = 'block';
      populateSubdirectories();
    } else {
      subdirRow.style.display = 'none';
    }
    handleLocationInput();
  }

  function openLocationModal() {
    const modal = document.getElementById('locationModal');
    if (modal) modal.classList.add('open');
    switchLocationTab('single');
    const input = document.getElementById('locationInput');
    const scopeSelect = document.getElementById('locationScopeSelect');
    if (scopeSelect) {
      scopeSelect.value = selectedIds.size > 0 ? 'selection' : 'trip';
      handleLocationScopeChange();
    }
    if (input) {
      input.value = CATALOG_DATA.trip_location_name || '';
      handleLocationInput();
    }
  }

  function closeLocationModal() {
    const modal = document.getElementById('locationModal');
    if (modal) modal.classList.remove('open');
  }

  // --- Bulk Location Override by Subdirectory ---

  let bulkLocationRowsData = [];
  let activeLocationTab = 'single';

  function switchLocationTab(tab) {
    activeLocationTab = tab;
    const singlePanel = document.getElementById('locationSinglePanel');
    const bulkPanel = document.getElementById('bulkLocationPanel');
    const tabSingle = document.getElementById('tabSingle');
    const tabBulk = document.getElementById('tabBulk');
    const modalFooter = document.getElementById('locationModalFooter');
    if (tab === 'bulk') {
      if (singlePanel) singlePanel.style.display = 'none';
      if (bulkPanel) bulkPanel.style.display = 'block';
      if (tabBulk) tabBulk.style.background = 'var(--accent-blue)';
      if (tabSingle) tabSingle.style.background = '';
      if (modalFooter) modalFooter.style.display = 'none';
      if (bulkLocationRowsData.length === 0) addBulkLocationRow();
    } else {
      if (singlePanel) singlePanel.style.display = 'block';
      if (bulkPanel) bulkPanel.style.display = 'none';
      if (tabSingle) tabSingle.style.background = 'var(--accent-blue)';
      if (tabBulk) tabBulk.style.background = '';
      if (modalFooter) modalFooter.style.display = 'flex';
    }
  }

  function addBulkLocationRow() {
    bulkLocationRowsData.push({ subdir: '', location: '' });
    renderBulkLocationRows();
  }

  function removeBulkLocationRow(idx) {
    bulkLocationRowsData.splice(idx, 1);
    renderBulkLocationRows();
  }

  function updateBulkRow(idx, field, value) {
    if (bulkLocationRowsData[idx]) {
      bulkLocationRowsData[idx][field] = value;
      renderBulkLocationPreview();
    }
  }

  function renderBulkLocationRows() {
    const container = document.getElementById('bulkLocationRows');
    if (!container) return;

    const sortedDirs = getAllSubdirectories();

    container.innerHTML = bulkLocationRowsData.map((row, idx) => {
      const opts = sortedDirs.map(d => {
        const depth = (d.match(/\//g) || []).length;
        const indent = '\u00A0\u00A0'.repeat(depth);
        const prefix = depth > 0 ? '\u2514\u2500 ' : '\uD83D\uDCC1 ';
        const sel = row.subdir === d ? ' selected' : '';
        return `<option value="${escHtml(d)}"${sel}>${indent}${prefix}${escHtml(d)}</option>`;
      }).join('');

      return `
        <div class="bulk-loc-row" style="display:flex;gap:8px;align-items:center;margin-bottom:8px;">
          <select style="flex:0 0 200px;" onchange="updateBulkRow(${idx},'subdir',this.value)">
            <option value="">-- Subdirectory --</option>
            ${opts}
          </select>
          <input type="text" style="flex:1;" placeholder="Location (place name or lat,lon)"
                 value="${escHtml(row.location)}" oninput="updateBulkRow(${idx},'location',this.value)"/>
          <button class="btn btn-secondary" style="padding:4px 8px;font-size:0.8rem;"
                  onclick="removeBulkLocationRow(${idx})">&#x2715;</button>
        </div>
      `;
    }).join('');

    renderBulkLocationPreview();
  }

  function buildBulkLocationCommands() {
    const validRows = bulkLocationRowsData.filter(r => r.subdir && r.location.trim());
    if (validRows.length === 0) return [];

    const bulkReclassToggle = document.getElementById('bulkReclassifyOnLocationChange');
    const isReclass = !bulkReclassToggle || bulkReclassToggle.checked;
    const reclassFlag = isReclass ? ' --reclassify' : '';

    const isHierarchy = CATALOG_DATA.mode === 'hierarchy';
    const modeFlag = isHierarchy ? '--mode hierarchy' : (CATALOG_DATA.mode === 'in-place-rename' ? '--mode in-place-rename' : '--mode in-place');

    let lines = [];
    if (CATALOG_DATA.catalog_dir) lines.push(`cd "${escapeShellArg(CATALOG_DATA.catalog_dir)}"`);
    lines.push(findAvicullCmd().trim());
    lines.push(`if [ -n "$AVICULL_CMD" ]; then`);
    validRows.forEach(r => {
      const safeDir = escapeShellArg(r.subdir);
      const safeLoc = escapeShellArg(r.location.trim());
      lines.push(`  avicull location --dir "${safeDir}" --location "${safeLoc}"${reclassFlag} 2>/dev/null || $AVICULL_CMD location --dir "${safeDir}" --location "${safeLoc}"${reclassFlag}`);
    });
    if (isReclass) {
      lines.push(`  $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
    }
    lines.push(`fi`);
    return lines;
  }

  function renderBulkLocationPreview() {
    const box = document.getElementById('bulkLocationCommandOutput');
    if (!box) return;

    const lines = buildBulkLocationCommands();
    if (lines.length === 0) {
      box.textContent = 'Add rows above to generate commands\u2026';
      return;
    }
    box.textContent = lines.join('\n');
  }

  function copyBulkLocationCommands() {
    const box = document.getElementById('bulkLocationCommandOutput');
    if (!box) return;
    navigator.clipboard.writeText(box.textContent).catch(() => {
      const ta = document.createElement('textarea');
      ta.value = box.textContent;
      document.body.appendChild(ta);
      ta.select();
      document.execCommand('copy');
      document.body.removeChild(ta);
    });
  }

  function applyBulkLocationBatch() {
    const cmds = buildBulkLocationCommands();
    if (cmds.length === 0) return;
    batchCommands.push({
      stem: 'bulk_location_overrides',
      commands: cmds
    });
    updateBatchUI();
    closeLocationModal();
  }

  function buildLocationCommands(locStr) {
    let commands = [];
    if (CATALOG_DATA.catalog_dir) {
      commands.push(`cd "${CATALOG_DATA.catalog_dir}"`);
    }
    commands.push(findAvicullCmd().trim());
    commands.push(`if [ -n "$AVICULL_CMD" ]; then`);

    const reclassToggle = document.getElementById('reclassifyOnLocationChange');
    const isReclass = !reclassToggle || reclassToggle.checked;
    const reclassFlag = isReclass ? ' --reclassify' : '';

    const isHierarchy = CATALOG_DATA.mode === 'hierarchy';
    const modeFlag = isHierarchy ? '--mode hierarchy' : (CATALOG_DATA.mode === 'in-place-rename' ? '--mode in-place-rename' : '--mode in-place');

    const scope = document.getElementById('locationScopeSelect') ? document.getElementById('locationScopeSelect').value : 'trip';
    if (scope === 'selection' && selectedIds.size > 0) {
      for (const id of selectedIds) {
        const item = items.find(i => i.id === id);
        if (item) {
          commands.push(`  avicull location --file "${item.original_stem}" --location "${locStr}"${reclassFlag} 2>/dev/null || $AVICULL_CMD location --file "${item.original_stem}" --location "${locStr}"${reclassFlag}`);
        }
      }
    } else if (scope === 'directory') {
      const subdirSelect = document.getElementById('locationSubdirSelect');
      const chosenDir = subdirSelect ? subdirSelect.value.trim() : '';
      if (chosenDir) {
        commands.push(`  avicull location --dir "${chosenDir}" --location "${locStr}"${reclassFlag} 2>/dev/null || $AVICULL_CMD location --dir "${chosenDir}" --location "${locStr}"${reclassFlag}`);
      } else {
        commands.push(`  avicull location --location "${locStr}"${reclassFlag} 2>/dev/null || $AVICULL_CMD location --location "${locStr}"${reclassFlag}`);
      }
    } else {
      commands.push(`  avicull location --location "${locStr}"${reclassFlag} 2>/dev/null || $AVICULL_CMD location --location "${locStr}"${reclassFlag}`);
    }
    if (isReclass) {
      commands.push(`  $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
    }
    commands.push(`fi`);
    return commands;
  }

  // Reclassification Review & Diff State
  let reclassifyDiffItems = [];
  let reclassifyScopeContext = { scope: 'trip', location: '', dir: '' };

  function openReclassifyReviewModal() {
    closeLocationModal();
    const modal = document.getElementById('reclassifyModal');
    if (!modal) return;

    // Detect scope from location modal:
    const isBulkTab = (activeLocationTab === 'bulk');
    let targetItems = [];
    let locValue = '';
    let chosenDir = '';
    let scopeDesc = '';

    if (isBulkTab) {
      const activeRows = bulkLocationRowsData.filter(r => r.subdir && r.location && r.location.trim());
      if (activeRows.length > 0) {
        const subdirsSet = new Set(activeRows.map(r => r.subdir));
        targetItems = items.filter(i => {
          if (!i.subdirectory) return false;
          for (const s of subdirsSet) {
            if (i.subdirectory === s || i.subdirectory.startsWith(s + '/')) return true;
          }
          return false;
        });
        reclassifyScopeContext = { scope: 'bulk', rows: activeRows };
        scopeDesc = `Directory Overrides (${activeRows.length} directories)`;
      } else {
        targetItems = [];
        reclassifyScopeContext = { scope: 'bulk', rows: [] };
        scopeDesc = 'Directory Overrides';
      }
    } else {
      const scopeSelect = document.getElementById('locationScopeSelect');
      const scope = scopeSelect ? scopeSelect.value : 'trip';
      const locInput = document.getElementById('locationInput');
      locValue = locInput ? locInput.value.trim() : '';

      if (scope === 'selection' && selectedIds.size > 0) {
        targetItems = items.filter(i => selectedIds.has(i.id));
        reclassifyScopeContext = { scope: 'selection', location: locValue, selectedIds: Array.from(selectedIds) };
        scopeDesc = `Selected Photos (${targetItems.length})`;
      } else if (scope === 'directory') {
        const subdirSelect = document.getElementById('locationSubdirSelect');
        chosenDir = subdirSelect ? subdirSelect.value.trim() : '';
        if (chosenDir) {
          targetItems = items.filter(i => i.subdirectory && (i.subdirectory === chosenDir || i.subdirectory.startsWith(chosenDir + '/')));
        } else {
          targetItems = items;
        }
        reclassifyScopeContext = { scope: 'directory', dir: chosenDir, location: locValue };
        scopeDesc = chosenDir ? `Subdirectory "${chosenDir}"` : 'All Subdirectories';
      } else {
        targetItems = items;
        reclassifyScopeContext = { scope: 'trip', location: locValue };
        scopeDesc = 'Entire Trip';
      }
    }

    const scopeDescEl = document.getElementById('reclassifyScopeDesc');
    if (scopeDescEl) {
      scopeDescEl.textContent = scopeDesc ? ` (${scopeDesc})` : '';
    }

    // Look for top predictions or alternative candidates
    reclassifyDiffItems = targetItems.map(item => {
      let altSpecies = item.assigned_species;
      let altConf = item.confidence;
      if (item.top_predictions && item.top_predictions.length > 1) {
        const firstPred = item.top_predictions[0];
        const secondPred = item.top_predictions[1];
        const firstScore = firstPred.score || firstPred.combined_score || 0;
        const secondScore = secondPred.score || secondPred.combined_score || 0;

        if (item.assigned_species === firstPred.common_name && firstScore >= 0.85) {
          altSpecies = firstPred.common_name;
        } else {
          altSpecies = (item.assigned_species === firstPred.common_name) ? secondPred.common_name : firstPred.common_name;
          altConf = secondScore;
        }
      } else if (item.routing_tier === RoutingTier.NEEDS_REVIEW) {
        altSpecies = item.assigned_species;
      }

      const willChange = altSpecies !== item.assigned_species;
      return {
        item,
        currentSpecies: item.assigned_species,
        proposedSpecies: altSpecies,
        choice: willChange ? 'take' : 'keep',
        customSpecies: altSpecies,
      };
    });

    renderReclassifyDiffTable();
    modal.classList.add('open');
  }

  function closeReclassifyModal() {
    const modal = document.getElementById('reclassifyModal');
    if (modal) modal.classList.remove('open');
  }

  function setAllReclassifyChoices(choice) {
    for (const d of reclassifyDiffItems) {
      d.choice = choice;
    }
    renderReclassifyDiffTable();
  }

  function setReclassifyChoice(idx, choice) {
    if (reclassifyDiffItems[idx]) {
      reclassifyDiffItems[idx].choice = choice;
      renderReclassifyDiffTable();
    }
  }

  function renderReclassifyDiffTable() {
    const tbody = document.getElementById('reclassifyDiffTableBody');
    if (!tbody) return;

    const countEl = document.getElementById('reclassifyChangeCount');
    const takeCount = reclassifyDiffItems.filter(d => d.choice === 'take' && d.currentSpecies !== d.proposedSpecies).length;
    if (countEl) countEl.textContent = takeCount;

    tbody.textContent = '';

    if (reclassifyDiffItems.length === 0) {
      const tr = document.createElement('tr');
      const td = document.createElement('td');
      td.colSpan = 4;
      td.style.textAlign = 'center';
      td.style.padding = '36px 16px';
      td.style.color = 'var(--text-muted)';
      td.textContent = 'No photos found matching the selected location scope.';
      tr.appendChild(td);
      tbody.appendChild(tr);
      updateReclassifyCommandOutput();
      return;
    }

    reclassifyDiffItems.forEach((d, idx) => {
      const isTake = d.choice === 'take';
      const isKeep = d.choice === 'keep';
      const thumb = d.item.embedded_thumb_data_uri || d.item.thumb_src || d.item.preview_url;

      const tr = document.createElement('tr');

      // Col 1: Thumbnail
      const tdThumb = document.createElement('td');
      const safeThumb = sanitizeMediaUri(thumb);
      if (safeThumb) {
        const img = document.createElement('img');
        img.src = safeThumb;
        img.className = 'diff-thumb';
        img.alt = d.item.original_stem || '';
        tdThumb.appendChild(img);
      } else {
        const placeholder = document.createElement('div');
        placeholder.className = 'diff-thumb';
        placeholder.style.background = 'var(--border-color)';
        tdThumb.appendChild(placeholder);
      }
      tr.appendChild(tdThumb);

      // Col 2: Current Species & filename
      const tdCurr = document.createElement('td');
      const currSpeciesDiv = document.createElement('div');
      currSpeciesDiv.style.fontWeight = '600';
      currSpeciesDiv.textContent = d.currentSpecies || '';
      const currFileDiv = document.createElement('div');
      currFileDiv.style.fontSize = '0.75rem';
      currFileDiv.style.color = 'var(--text-muted)';
      currFileDiv.textContent = d.item.primary_filename || '';
      tdCurr.appendChild(currSpeciesDiv);
      tdCurr.appendChild(currFileDiv);
      tr.appendChild(tdCurr);

      // Col 3: Proposed Species
      const tdProp = document.createElement('td');
      const propSpeciesDiv = document.createElement('div');
      propSpeciesDiv.style.fontWeight = '600';
      propSpeciesDiv.style.color = '#38bdf8';
      propSpeciesDiv.textContent = d.proposedSpecies || '';
      const propDescDiv = document.createElement('div');
      propDescDiv.style.fontSize = '0.75rem';
      propDescDiv.style.color = 'var(--text-muted)';
      propDescDiv.textContent = 'Recalculated with updated location';
      tdProp.appendChild(propSpeciesDiv);
      tdProp.appendChild(propDescDiv);
      tr.appendChild(tdProp);

      // Col 4: Action pills
      const tdAction = document.createElement('td');
      tdAction.style.textAlign = 'right';
      const pillGroup = document.createElement('div');
      pillGroup.className = 'choice-pill-group';

      const btnTake = document.createElement('button');
      btnTake.type = 'button';
      btnTake.className = `choice-pill ${isTake ? 'active-take' : ''}`;
      btnTake.textContent = 'Take';
      btnTake.onclick = (e) => {
        e.stopPropagation();
        setReclassifyChoice(idx, 'take');
      };

      const btnKeep = document.createElement('button');
      btnKeep.type = 'button';
      btnKeep.className = `choice-pill ${isKeep ? 'active-keep' : ''}`;
      btnKeep.textContent = 'Keep';
      btnKeep.onclick = (e) => {
        e.stopPropagation();
        setReclassifyChoice(idx, 'keep');
      };

      pillGroup.appendChild(btnTake);
      pillGroup.appendChild(btnKeep);
      tdAction.appendChild(pillGroup);
      tr.appendChild(tdAction);

      tbody.appendChild(tr);
    });

    updateReclassifyCommandOutput();
  }

  function buildReclassifyCommands() {
    let commands = [];
    if (CATALOG_DATA.catalog_dir) {
      commands.push(`cd "${escapeShellArg(CATALOG_DATA.catalog_dir)}"`);
    }
    commands.push(findAvicullCmd().trim());
    commands.push(`if [ -n "$AVICULL_CMD" ]; then`);

    if (reclassifyScopeContext.scope === 'bulk' && reclassifyScopeContext.rows) {
      for (const row of reclassifyScopeContext.rows) {
        if (row.subdir && row.location && row.location.trim()) {
          const escSub = escapeShellArg(row.subdir);
          const escLoc = escapeShellArg(row.location.trim());
          commands.push(`  avicull location --dir "${escSub}" --location "${escLoc}" --reclassify 2>/dev/null || $AVICULL_CMD location --dir "${escSub}" --location "${escLoc}" --reclassify`);
        }
      }
    } else if (reclassifyScopeContext.scope === 'directory' && reclassifyScopeContext.dir) {
      const escDir = escapeShellArg(reclassifyScopeContext.dir);
      const escLoc = escapeShellArg(reclassifyScopeContext.location || '');
      if (escLoc) {
        commands.push(`  avicull location --dir "${escDir}" --location "${escLoc}" --reclassify 2>/dev/null || $AVICULL_CMD location --dir "${escDir}" --location "${escLoc}" --reclassify`);
      } else {
        commands.push(`  avicull location --dir "${escDir}" --reclassify 2>/dev/null || $AVICULL_CMD location --dir "${escDir}" --reclassify`);
      }
    } else if (reclassifyScopeContext.scope === 'selection') {
      const escLoc = escapeShellArg(reclassifyScopeContext.location || '');
      for (const id of (reclassifyScopeContext.selectedIds || [])) {
        const item = items.find(i => i.id === id);
        if (item) {
          const escStem = escapeShellArg(item.original_stem);
          if (escLoc) {
            commands.push(`  avicull location --file "${escStem}" --location "${escLoc}" --reclassify 2>/dev/null || $AVICULL_CMD location --file "${escStem}" --location "${escLoc}" --reclassify`);
          }
        }
      }
    } else {
      const escLoc = escapeShellArg(reclassifyScopeContext.location || '');
      if (escLoc) {
        commands.push(`  avicull location --location "${escLoc}" --reclassify 2>/dev/null || $AVICULL_CMD location --location "${escLoc}" --reclassify`);
      } else {
        commands.push(`  avicull location --reclassify 2>/dev/null || $AVICULL_CMD location --reclassify`);
      }
    }

    for (const d of reclassifyDiffItems) {
      if (d.choice === 'take' && d.currentSpecies !== d.proposedSpecies) {
        const escStem = escapeShellArg(d.item.original_stem);
        const escSpec = escapeShellArg(d.proposedSpecies);
        const cat = d.item.category || AssetCategory.NO_SUBJECT_DETECTED;
        commands.push(`  avicull correct --category "${cat}" --species "${escSpec}" --file "${escStem}" 2>/dev/null || $AVICULL_CMD correct --category "${cat}" --species "${escSpec}" --file "${escStem}"`);
      }
    }

    const isHierarchy = CATALOG_DATA.mode === 'hierarchy';
    const modeFlag = isHierarchy ? '--mode hierarchy' : (CATALOG_DATA.mode === 'in-place-rename' ? '--mode in-place-rename' : '--mode in-place');
    commands.push(`  $AVICULL_CMD organize --input "." ${modeFlag} --no-prompt || true`);
    commands.push(`fi`);
    return commands;
  }

  function updateReclassifyCommandOutput() {
    const out = document.getElementById('reclassifyCommandOutput');
    if (!out) return;
    const cmds = buildReclassifyCommands();
    out.textContent = cmds.join('\n');
  }

  function copyReclassifyCommand() {
    const text = document.getElementById('reclassifyCommandOutput').textContent;
    if (!text) return;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('btnCopyReclassifyCommand');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 1500);
      }
    }).catch(() => {
      alert("Commands:\n\n" + text);
    });
  }

  function applyReclassifyBatch() {
    const cmds = buildReclassifyCommands();
    batchCommands.push({
      stem: 'reclassify_updates',
      commands: cmds
    });
    updateBatchUI();
    closeReclassifyModal();
  }

  function handleLocationInput() {
    const input = document.getElementById('locationInput');
    const out = document.getElementById('locationCommandOutput');
    if (!input || !out) return;
    const val = input.value.trim();
    if (!val) {
      out.textContent = "Enter a location name or coordinates above to generate location command...";
      return;
    }
    const cmds = buildLocationCommands(val);
    out.textContent = cmds.join('\n');
  }

  function copyLocationCommand() {
    const text = document.getElementById('locationCommandOutput').textContent;
    if (!text || text.startsWith("Enter a location")) return;
    navigator.clipboard.writeText(text).then(() => {
      const btn = document.getElementById('btnCopyLocationCommand');
      if (btn) {
        const orig = btn.textContent;
        btn.textContent = "Copied!";
        setTimeout(() => { btn.textContent = orig; }, 1500);
      }
    }).catch(() => {
      alert("Command:\n\n" + text);
    });
  }

  function addLocationToBatch() {
    const input = document.getElementById('locationInput');
    const val = input ? input.value.trim() : '';
    if (!val) return;
    const cmds = buildLocationCommands(val);
    batchCommands.push({
      stem: 'location_update',
      commands: cmds
    });
    updateBatchUI();
    closeLocationModal();
  }

  // Keyboard shortcuts for selection
  document.addEventListener('keydown', (e) => {
    // Escape clears selection or closes modal
    if (e.key === 'Escape') {
      const locModal = document.getElementById('locationModal');
      if (locModal && locModal.classList.contains('open')) {
        closeLocationModal();
        return;
      }
      const modal = document.getElementById('correctionModal');
      if (modal && modal.classList.contains('open')) {
        closeModal();
      } else if (selectedIds.size > 0) {
        clearSelection();
      }
    }
    // Cmd+A or Ctrl+A (when not typing in an input) selects all visible photos
    if ((e.metaKey || e.ctrlKey) && (e.key === 'a' || e.key === 'A')) {
      const tag = document.activeElement ? document.activeElement.tagName.toLowerCase() : '';
      if (tag !== 'input' && tag !== 'textarea') {
        e.preventDefault();
        selectAllVisible();
      }
    }
  });

  if (typeof window !== 'undefined') {
    window.selectSpecies = selectSpecies;
    window.setCategoryFilter = setCategoryFilter;
    window.setFilter = setFilter;
  }

  // Initialize on load
  document.addEventListener('DOMContentLoaded', () => {
    updateCategoryCounts();
    renderGallery();
  });
</script>

</body>
</html>
